{
  "name": "OtpCode",
  "type": "object",
  "properties": {
    "match_id": {
      "type": "string"
    },
    "owner_user_id": {
      "type": "string"
    },
    "otp_code": {
      "type": "string"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "used": {
      "type": "boolean",
      "default": false
    },
    "attempts": {
      "type": "number",
      "default": 0
    },
    "otp_hash": {
      "type": "string"
    },
    "locked": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "match_id",
    "otp_code",
    "expires_at"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "data.approved": true
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "data.approved": true
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "description": "One-time collection code. Expires after 5 minutes, 3 attempts then locked. Only the hash is used for verification; the plain code is visible to the owner only."
}
