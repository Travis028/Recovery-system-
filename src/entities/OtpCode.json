{
  "name": "OtpCode",
  "type": "object",
  "properties": {
    "match_id": {
      "type": "string"
    },
    "owner_user_id": {
      "type": "string"
    },
    "otp_code": {
      "type": "string"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "used": {
      "type": "boolean",
      "default": false
    },
    "attempts": {
      "type": "number",
      "default": 0
    },
    "otp_hash": {
      "type": "string"
    },
    "locked": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "match_id",
    "otp_code",
    "expires_at"
  ],
  "description": "One-time collection code. Expires after 5 minutes, 3 attempts then locked. Only the hash is used for verification; the plain code is visible to the owner only."
}
