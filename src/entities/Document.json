{
  "name": "Document",
  "type": "object",
  "properties": {
    "finder_user_id": {
      "type": "string"
    },
    "document_type": {
      "type": "string",
      "enum": [
        "National ID",
        "Passport",
        "Driver's License",
        "Birth Certificate",
        "Academic Certificate",
        "Student ID",
        "NHIF Health Card",
        "NSSF Card",
        "Employment ID",
        "Other"
      ]
    },
    "owner_name": {
      "type": "string"
    },
    "document_number": {
      "type": "string"
    },
    "found_location": {
      "type": "string"
    },
    "date_found": {
      "type": "string",
      "format": "date"
    },
    "pickup_point_id": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "ocr_name_confidence": {
      "type": "number"
    },
    "ocr_number_confidence": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "Found",
        "Matched",
        "Notified",
        "Returned",
        "Unclaimed"
      ],
      "default": "Found"
    },
    "returned_at": {
      "type": "string",
      "format": "date-time"
    },
    "image_sha256": {
      "type": "string"
    },
    "image_phash": {
      "type": "string"
    },
    "ocr_used": {
      "type": "boolean",
      "default": false
    },
    "ocr_name_accepted": {
      "type": "boolean"
    },
    "ocr_number_accepted": {
      "type": "boolean"
    },
    "duplicate_flag": {
      "type": "boolean",
      "default": false
    },
    "duplicate_reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "duplicate_of_id": {
      "type": "string"
    }
  },
  "required": [
    "document_type",
    "found_location",
    "pickup_point_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "data.approved": true
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
