{
  "name": "Claim",
  "type": "object",
  "properties": {
    "document_id": {
      "type": "string"
    },
    "document_type": {
      "type": "string"
    },
    "owner_user_id": {
      "type": "string"
    },
    "owner_name": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "document_number": {
      "type": "string"
    },
    "note": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Pending",
        "Approved",
        "Rejected"
      ],
      "default": "Pending"
    },
    "match_id": {
      "type": "string"
    },
    "reference_code": {
      "type": "string"
    }
  },
  "required": [
    "document_id",
    "owner_name",
    "phone"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "data.approved": true
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "data.approved": true
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
