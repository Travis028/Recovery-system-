# LDRS v6 backend settings (backend/.env). Keep this file private; it is Git-ignored.
DATABASE_URL=postgresql://ldrs_app:CHANGE_ME@127.0.0.1:5433/ldrs_local
HOST=127.0.0.1
PORT=4001
# Frontend origins allowed to send POST/PATCH requests (the Vite dev server runs on 5175).
APP_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5175,http://localhost:5175
# Dev only. When enabled, privileged second-step codes print to this backend terminal.
# NEVER enable in a publicly exposed environment or with real identity records.
LDRS_DEMO_OTP=1
LDRS_DEV_SEED=1
# Enable only behind HTTPS in future non-local deployments.
COOKIE_SECURE=0
